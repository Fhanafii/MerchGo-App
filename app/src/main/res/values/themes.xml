<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pitjarus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorError">@color/error</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Style kustom untuk membuat sudut melengkung hanya di bagian atas -->
    <style name="TopRoundedCard" parent="">
        <item name="cornerSizeTopLeft">37dp</item>
        <item name="cornerSizeTopRight">37dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.TopHeaderCard" parent="">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">40dp</item>
        <item name="cornerSizeBottomRight">40dp</item>
    </style>
    <style name="Theme.Pitjarus" parent="Base.Theme.Pitjarus" />
</resources>
